{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "web": {
      "root": "app/",
      "framework": "vite",
      "buildCommand": "npx vite build"
    },
    "api": {
      "root": "./",
      "framework": "fastapi",
      "entrypoint": "api.index:app",
      "functions": {
        "api/index.py": {
          "maxDuration": 60,
          "excludeFiles": "{app/**,docs/**,data/raw/**,data/scripts/**,**/tests/**,**/__pycache__/**,server/.venv/**,reports/*.png,logs/**}"
        }
      }
    }
  },
  "rewrites": [
    { "source": "/api/(.*)", "destination": { "service": "api" } },
    { "source": "/(.*)", "destination": { "service": "web" } }
  ]
}
